// Programa de teste — Fase 1: Analise Lexica com Flex + C++

// Declaracoes de variaveis
int     x       = 10;
float   pi      = 3.14;
bool    ativo   = true;
string  msg     = "ola mundo";

// Tokens especiais
123.456.789-09
12.345.678/0001-90
joao@email.com
15/03/2025
14:30:00
(11)99999-8888
01310-100
0xFF

// Estruturas de controle
while (x > 0) {
    x = x - 1;
}

if (x == 0) {
    print("zero");
} else {
    print("nao zero");
}

// Operadores logicos
bool valido = (x >= 0) && (ativo != false);

if (!valido || x < 10) {
    print("condicao atendida");
}

return x;
